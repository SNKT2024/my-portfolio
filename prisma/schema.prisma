// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model HeroSection {
  id Int @id @default(autoincrement())
  name             String   @default("Sanket Kumbhar")
  role             String   @default("Full Stack Developer")
  tagline          String   @db.Text
  primaryCtaText   String   @default("View / Download Resume")
  primaryCtaUrl    String   @default("#resume")
  secondaryCtaText String   @default("Explore Projects")
  secondaryCtaUrl  String   @default("#projects")
  statusBadge      String   @default("[ Available for Full-Time Roles 🟢 ]")
  avatarUrl        String?
  updatedAt        DateTime @updatedAt
}

model AboutSection {
  id           String   @id @default("about_singleton")
  heading      String   @default("About Me")
  avatarUrl    String?
  location     String   @default("India")
  stats        Json?    // e.g. [{ "label": "Years Exp", "value": "2+" }, { "label": "DSA Problems", "value": "500+" }]
  background  Json?
  highlights Json?
  updatedAt    DateTime @updatedAt
}



enum SkillFamiliarity {
  CORE
  FAMILIAR
}

model SkillCategory {
  id        String   @id @default(uuid())
  name      String   // "Frontend", "Backend & Database", "Core & DSA", "AI & Tooling"
  order     Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Skill {
  id         String        @id @default(uuid())
  name       String        // "React", "PostgreSQL", "C++", "Next.js"
  iconKey    String?
  order      Int           @default(0)
  familiarity SkillFamiliarity @default(FAMILIAR)
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
}

model Project {
  id          String   @id @default(uuid())
  title       String
  category String
  type String
  description String   @db.Text
  points      String[] // Array of impact bullets
  techStack   String[] // Array of tags e.g. ["Next.js", "Prisma", "PostgreSQL"]
  imageUrl    String?
  liveUrl     String?
  githubUrl   String?
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


enum Status{
  CURRENT
  COMPLETED
}

model Experience {
  id          String   @id @default(uuid())
  role        String   // e.g. "Full Stack Developer"
  company     String   // e.g. "Tech Corp"
  location    String?  // e.g. "Remote"
  startDate   String   // e.g. "June 2024"
  endDate     String?  // e.g. "Present"
  status  Status @default(COMPLETED)
  description String
  points      String[] // Accomplishments & key contributions
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id          String   @id @default(uuid())
  degree      String   // e.g. "Master of Computer Applications (MCA)"
  institution String   // e.g. "CSIBER, Kolhapur"
  location    String?  // e.g. "Kolhapur, India"
  startYear   String   // e.g. "2023"
  endYear     String   // e.g. "2025"
  grade       String?  // e.g. "8.5 CGPA" or "First Class with Distinction"
  description String
  points      String[] // Coursework, highlights, or key academic projects
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SocialLink {
  id        String   @id @default(uuid())
  title     String   // "GitHub", "LinkedIn", "Resume", "LeetCode"
  url       String   // "https://github.com/..."
  iconKey   String   // "github", "linkedin", "code", "file-text"
  isPrimary Boolean  @default(false) // Primary CTA button vs Icon badge
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}